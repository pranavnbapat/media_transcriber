WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=
MAX_VIDEO_DURATION_SEC=3600

API_KEY=
BASIC_USER=
BASIC_PASS=

# ---- Hosted transcription (optional) ----
# Set both to transcribe through an OpenAI-compatible endpoint instead of
# loading Whisper into this process. Leave unset to keep using faster-whisper
# locally, which is the previous behaviour.
#
# Whisper-large on CPU is impractically slow and the Kubernetes nodes have no
# GPU, so a hosted endpoint is what makes this service viable there.
WHISPER_API_URL=
WHISPER_API_KEY=
# The model the endpoint serves. Scaleway: whisper-large-v3
WHISPER_API_MODEL=whisper-large-v3
# Audio is uploaded as mono MP3, not raw PCM: the WAV used locally is 32 KB/s
# and would pass the endpoint's ~25 MB limit after about 13.6 minutes.
WHISPER_API_BITRATE=32k
WHISPER_API_MAX_BYTES=26214400
WHISPER_API_TIMEOUT=600
